# Copy to infra/.env (git-ignored) and fill in.

# Grafana admin login (required). Anonymous visitors get read-only access.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Public URL. The host's nginx serves it (infra/nginx/o11y.conf); on the VPS uncomment these.
# O11Y_URL=https://o11y.raashed.com
# GRAFANA_COOKIE_SECURE=true

# Alert notifications (optional). Paste a webhook URL to get alerts in chat; type is one of
# discord, slack, teams, googlechat or webhook. Load-test alerts only show on the dashboards.
ALERT_WEBHOOK_TYPE=discord
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Visitor-started load tests (the "Run a load test" button). Visitors cannot change these.
RUNNER_SCRIPT=load          # load (constant rate) or break (ramp to 1000 VUs over 60s)
RUNNER_RATE=500             # requests per second, for the load script
RUNNER_DURATION=30s         # how long the load script runs
RUNNER_COOLDOWN=60s         # pause between tests so the VPS can settle
RUNNER_PER_IP_HOURLY=3      # tests each visitor can start per hour
# RUNNER_MATCH_RATE=500     # requests per second to each server in a head-to-head race (default RUNNER_RATE)

# Workers/threads for every server (Rust, Go, Python), so they compete on equal terms
WORKERS=2

PROMETHEUS_RETENTION=30d
