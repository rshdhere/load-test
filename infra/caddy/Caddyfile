{
	admin 0.0.0.0:2019
	metrics {
		per_host
	}
}

{$O11Y_SITE} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Prometheus scrapes these on the internal network; keep them off the internet
	handle /metrics {
		respond 404
	}

	# Visitor-started load tests
	handle /run* {
		reverse_proxy runner:8080
	}

	handle {
		reverse_proxy grafana:3001
	}
}
