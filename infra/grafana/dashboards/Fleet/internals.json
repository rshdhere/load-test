        "y": 25,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Slowest recent requests",
      "description": "Sampled server requests slower than 5 ms, from the selected servers. Most take well under a millisecond.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && resource.service.name=~\"actix|axum|tokio|go|gin|fiber|fastapi|flask|django|bun|node|express|fastify\" && duration > 5ms}",
          "limit": 20,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Recent requests",
      "description": "The latest sampled requests from the selected servers.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
