{
  "uid": "leaderboard",
  "title": "Leaderboard",
  "description": "The 13 servers ranked by throughput per CPU core and per MB of memory, plus tail latency at a fixed request rate.",
  "tags": [
    "overview",
    "comparison",
    "load-testing"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "liveNow": false,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 2,
        "refresh": 1
      },
      {
        "name": "rate",
        "label": "Fixed rate (req/s)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(k6_vus{script=\"load\"}, rate)",
        "query": {
          "query": "label_values(k6_vus{script=\"load\"}, rate)",
          "refId": "rate-var"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "sort": 3,
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "text": "500",
          "value": "500"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Load tests",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 152, 48, 0.5)",
        "expr": "count by (server, testid) (count_over_time(k6_http_reqs_total{group!~\"::setup|::teardown\"}[10s]))",
        "step": "5s",
        "titleFormat": "Load test on {{server}}",
        "textFormat": "{{testid}}",
        "tagKeys": "server",
        "useValueForTime": false
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(115, 191, 105, 1)",
        "expr": "max by (commit) (o11y_build_info) unless max by (commit) (o11y_build_info offset 2m)",
        "step": "30s",
        "titleFormat": "Deployed",
        "textFormat": "commit {{commit}}",
        "tagKeys": "commit",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/fleet",
      "icon": "apps",
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "All servers at a glance"
    },
    {
      "title": "Run a load test",
      "type": "link",
      "url": "/run/",
      "icon": "bolt",
      "keepTime": false,
      "targetBlank": true,
      "tooltip": "Start a load test against one server (one at a time)"
    },
    {
      "title": "Servers",
      "type": "dashboards",
      "tags": [
        "per-server"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Compare",
      "type": "dashboards",
      "tags": [
        "comparison"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Load testing",
      "type": "dashboards",
      "tags": [
        "load-testing"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Ops",
      "type": "dashboards",
      "tags": [
        "ops"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "**Test conditions.** Every server, the k6 load generator, Grafana and Prometheus share one small VPS (alongside unrelated sites), so results are noisy and k6 competes with the server under test for CPU. Each server runs with `WORKERS=2`. Visitor tests use the `load` script at a constant rate (500 req/s for 30 s by default); `break` runs ramp to 1000 virtual users over 60 s. Read this as a rough comparison, not a rigorous ranking.",
        "code": {
          "language": "plaintext"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "table",
      "title": "Leaderboard",
      "description": "Servers ranked by requests served per CPU core, over every load test in the time range. Req/s per MB divides peak throughput by peak working-set memory under load. The p99 column only counts `load` runs at the selected rate, so it is like for like.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server, language, framework) (probe_success{job=\"server-health\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum_over_time((sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[1m])))[$__range:15s]) / sum_over_time((server:container_cpu:rate1m{server=~\"actix|axum|tokio|go|gin|fiber|fastapi|flask|django|bun|node|express|fastify\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s])",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[5s])))[$__range:1s]) / (max_over_time((server:container_memory:working_set{server=~\"actix|axum|tokio|go|gin|fiber|fastapi|flask|django|bun|node|express|fastify\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s]) / 1e6)",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.5, (max by (server) (k6_http_req_duration_p99{group!~\"::setup|::teardown\",script=\"load\",rate=\"$rate\"}))[$__range:2s])",
          "legendFormat": "",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[5s])))[$__range:1s])",
          "legendFormat": "",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((server:container_memory:working_set{server=~\"actix|axum|tokio|go|gin|fiber|fastapi|flask|django|bun|node|express|fastify\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s])",
          "legendFormat": "",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "Value #E",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "server": 0,
              "language": 1,
              "framework": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #B",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "server"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Server"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__value.raw} dashboard",
                    "url": "/d/server-${__value.raw}?${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "language"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Language"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "framework"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Framework"
              },
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Req/s per core"
              },
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Req/s per MB"
              },
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p99 at $rate req/s"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.1
                    },
                    {
                      "color": "red",
                      "value": 0.5
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Peak req/s"
              },
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #F"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Peak memory under load"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 15
      }
    },
    {
      "type": "bargauge",
      "title": "Req/s per CPU core",
      "description": "Requests served per CPU-second while under load. Higher is better.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum_over_time((sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[1m])))[$__range:15s]) / sum_over_time((server:container_cpu:rate1m{server=~\"actix|axum|tokio|go|gin|fiber|fastapi|flask|django|bun|node|express|fastify\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s]))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 12
      }
    },
    {
      "type": "bargauge",
      "title": "Req/s per MB of memory",
      "description": "Peak throughput divided by peak memory under load. Higher is better.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(max_over_time((sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[5s])))[$__range:1s]) / (max_over_time((server:container_memory:working_set{server=~\"actix|axum|tokio|go|gin|fiber|fastapi|flask|django|bun|node|express|fastify\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s]) / 1e6))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 12
      }
    },
    {
      "type": "bargauge",
      "title": "p99 at $rate req/s",
      "description": "Median over `load` runs at the selected rate of each 1s window's p99. Lower is better.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort(quantile_over_time(0.5, (max by (server) (k6_http_req_duration_p99{group!~\"::setup|::teardown\",script=\"load\",rate=\"$rate\"}))[$__range:2s]))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 12
      }
    }
  ]
}
