{
  "uid": "match",
  "title": "Head to Head",
  "description": "Two or three servers raced at the same rate at the same time: winners, a scoreboard and the race second by second.",
  "tags": [
    "live",
    "comparison",
    "load-testing"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "liveNow": false,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 2,
        "refresh": 1
      },
      {
        "name": "match",
        "label": "Race",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(k6_http_reqs_total{script=\"match\"}, match)",
        "query": {
          "query": "label_values(k6_http_reqs_total{script=\"match\"}, match)",
          "refId": "match-var"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "sort": 2,
        "hide": 0,
        "regex": "",
        "options": []
      },
      {
        "name": "server",
        "label": "Servers",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(k6_http_reqs_total{match=\"$match\"}, server)",
        "query": {
          "query": "label_values(k6_http_reqs_total{match=\"$match\"}, server)",
          "refId": "server-var"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "sort": 2,
        "hide": 2,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Load tests",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 152, 48, 0.5)",
        "expr": "count by (server, testid) (count_over_time(k6_http_reqs_total{group!~\"::setup|::teardown\"}[10s]))",
        "step": "5s",
        "titleFormat": "Load test on {{server}}",
        "textFormat": "{{testid}}",
        "tagKeys": "server",
        "useValueForTime": false
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(115, 191, 105, 1)",
        "expr": "max by (commit) (o11y_build_info) unless max by (commit) (o11y_build_info offset 2m)",
        "step": "30s",
        "titleFormat": "Deployed",
        "textFormat": "commit {{commit}}",
        "tagKeys": "commit",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/fleet",
      "icon": "apps",
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "All servers at a glance"
    },
    {
      "title": "Run a load test",
      "type": "link",
      "url": "/run/",
      "icon": "bolt",
      "keepTime": false,
      "targetBlank": true,
      "tooltip": "Start a load test against one server (one at a time)"
    },
    {
      "title": "Servers",
      "type": "dashboards",
      "tags": [
        "per-server"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Compare",
      "type": "dashboards",
      "tags": [
        "comparison"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Load testing",
      "type": "dashboards",
      "tags": [
        "load-testing"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Ops",
      "type": "dashboards",
      "tags": [
        "ops"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "title": "Start a race",
      "type": "link",
      "icon": "bolt",
      "url": "/run/compare",
      "keepTime": false,
      "targetBlank": true,
      "tooltip": "Race 2-3 servers against each other"
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "### \u2694 Head to head\nEvery server in this race got the **same request rate at the same moment**, from one k6 process on the same machine, so they also competed for CPU: a hungry server can slow its rivals. Pick an earlier race from **Race** above (widen the time range to when it ran). **<a href=\"/run/compare\" target=\"_self\">Start a new race</a>**.",
        "code": {
          "language": "plaintext"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "row",
      "id": 2,
      "title": "Winners",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Lowest p99",
      "description": "Lowest typical p99 latency: the median of each 1s window's p99.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "bottomk(1, quantile_over_time(0.5, (max by (server) (k6_http_req_duration_p99{match=\"$match\",group!~\"::setup|::teardown\"}))[$__range:2s]))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "mappings": [],
          "noValue": "No tests in range"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Lowest median",
      "description": "Lowest typical median latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "bottomk(1, quantile_over_time(0.5, (max by (server) (k6_http_req_duration_p50{match=\"$match\",group!~\"::setup|::teardown\"}))[$__range:2s]))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "mappings": [],
          "noValue": "No tests in range"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 4,
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Fewest errors",
      "description": "Lowest share of failed requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "bottomk(1, (sum by (server) (max_over_time(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\",expected_response=\"false\"}[$__range])) or sum by (server) (max_over_time(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[$__range])) * 0) / sum by (server) (max_over_time(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[$__range])))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "mappings": [],
          "noValue": "No tests in range"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Most efficient",
      "description": "Most requests served per CPU-second during the race.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(1, sum_over_time((sum by (server) (rate(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[1m])))[$__range:15s]) / sum_over_time((server:container_cpu:rate1m{server=~\"$server\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s]))",
          "legendFormat": "{{server}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "No tests in range"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "id": 6,
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 5
      }
    },
    {
      "type": "row",
      "id": 7,
      "title": "Scoreboard",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Scoreboard",
      "description": "Every racer side by side, fastest typical p99 first. Click a server for its dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (server) (max_over_time(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (server) (max_over_time(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\",expected_response=\"false\"}[$__range])) or sum by (server) (max_over_time(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[$__range])) * 0) / sum by (server) (max_over_time(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[$__range]))",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.5, (max by (server) (k6_http_req_duration_p50{match=\"$match\",group!~\"::setup|::teardown\"}))[$__range:2s])",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.5, (max by (server) (k6_http_req_duration_p95{match=\"$match\",group!~\"::setup|::teardown\"}))[$__range:2s])",
          "legendFormat": "",
          "refId": "D",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.5, (max by (server) (k6_http_req_duration_p99{match=\"$match\",group!~\"::setup|::teardown\"}))[$__range:2s])",
          "legendFormat": "",
          "refId": "E",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (server) (max_over_time(k6_http_req_duration_p99{match=\"$match\",group!~\"::setup|::teardown\"}[$__range]))",
          "legendFormat": "",
          "refId": "F",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((server:container_cpu:rate1m{server=~\"$server\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s])",
          "legendFormat": "",
          "refId": "G",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum_over_time((sum by (server) (rate(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[1m])))[$__range:15s]) / sum_over_time((server:container_cpu:rate1m{server=~\"$server\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s])",
          "legendFormat": "",
          "refId": "H",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time((server:container_memory:working_set{server=~\"$server\"} and on (server) (sum by (server) (rate(k6_http_reqs_total{match=\"$match\",group!~\"::setup|::teardown\"}[1m])) > 0))[$__range:15s])",
          "legendFormat": "",
          "refId": "I",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "server": 0
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value #E"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
